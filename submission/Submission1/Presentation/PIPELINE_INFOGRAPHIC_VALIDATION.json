    {
      "page": "02 - APIs and model roles",
      "text": "IMPLEMENTED TEXT PROTOTYPE  /  SEPTEMBER 2026",
      "lines": 1,
      "height": 24
    },
    {
      "page": "02 - APIs and model roles",
      "text": "Which API does what?",
      "lines": 1,
      "height": 62
    },
    {
      "page": "02 - APIs and model roles",
      "text": "POST /analysis/text sends the claim to FastAPI, which coordinates the external services below.",
      "lines": 1,
      "height": 30
    },
    {
      "page": "02 - APIs and model roles",
      "text": "UIABO  /  FINAL YEAR PROJECT                                         2 / 02",
      "lines": 1,
      "height": 22
    },
    {
      "page": "02 - APIs and model roles",
      "text": "SERVICE",
      "lines": 1,
      "height": 23
    },
    {
      "page": "02 - APIs and model roles",
      "text": "ROLE IN UIABO",
      "lines": 1,
      "height": 23
    },
    {
      "page": "02 - APIs and model roles",
      "text": "INTERFACE USED",
      "lines": 1,
      "height": 23
    },
    {
      "page": "02 - APIs and model roles",
      "text": "MODELS / KEY DETAIL",
      "lines": 1,
      "height": 23
    },
    {
      "page": "02 - APIs and model roles",
      "text": "ACCESS",
      "lines": 1,
      "height": 18
    },
    {
      "page": "02 - APIs and model roles",
      "text": "Firebase\nAuthentication",
      "lines": 2,
      "height": 58
    },
    {
      "page": "02 - APIs and model roles",
      "text": "Sign in and identify the user.\nBackend verifies the ID token\nand email-verification status.",
      "lines": 3,
      "height": 81
    },
    {
      "page": "02 - APIs and model roles",
      "text": "Firebase JS SDK in the app\nFirebase Admin SDK on backend",
      "lines": 2,
      "height": 58
    },
    {
      "page": "02 - APIs and model roles",
      "text": "Controls account access.\nDoes not decide whether\na claim is true.",
      "lines": 3,
      "height": 81
    },
    {
      "page": "02 - APIs and model roles",
      "text": "STEPS 02\u201305",
      "lines": 1,
      "height": 18
    },
    {
      "page": "02 - APIs and model roles",
      "text": "Ollama Cloud",
      "lines": 1,
      "height": 29
    },
    {
      "page": "02 - APIs and model roles",
      "text": "3 models vote on the category.\nGemma extracts + expands queries.\nGPT-OSS selects + assesses evidence.",
      "lines": 3,
      "height": 81
    },
    {
      "page": "02 - APIs and model roles",
      "text": "POST ollama.com/api/chat\nHTTPS model inference",
      "lines": 2,
      "height": 58
    },
    {
      "page": "02 - APIs and model roles",
      "text": "gpt-oss:120b\ngemma4:31b\nnemotron-3-super",
      "lines": 3,
      "height": 81
    },
    {
      "page": "02 - APIs and model roles",
      "text": "STEP 03",
      "lines": 1,
      "height": 18
    },
    {
      "page": "02 - APIs and model roles",
      "text": "Google\nFact Check Tools",
      "lines": 2,
      "height": 58
    },
    {
      "page": "02 - APIs and model roles",
      "text": "Find existing published fact checks.\nUse review links to discover\noriginal evidence pages.",
      "lines": 3,
      "height": 81
    },
    {
      "page": "02 - APIs and model roles",
      "text": "GET factchecktools.googleapis.com\n/v1alpha1/claims:search",
      "lines": 2,
      "height": 58
    },
    {
      "page": "02 - APIs and model roles",
      "text": "Discovery only. An empty\nmatch does not mean the\nclaim is false.",
      "lines": 3,
      "height": 81
    },
    {
      "page": "02 - APIs and model roles",
      "text": "STEPS 03\u201304",
      "lines": 1,
      "height": 18
    },
    {
      "page": "02 - APIs and model roles",
      "text": "Tavily",
      "lines": 1,
      "height": 29
    },
    {
      "page": "02 - APIs and model roles",
      "text": "Search preferred and wider sources.\nExtract original page text for\npassage selection and assessment.",
      "lines": 3,
      "height": 81
    },
    {
      "page": "02 - APIs and model roles",
      "text": "POST api.tavily.com/search\nPOST api.tavily.com/extract",
      "lines": 2,
      "height": 58
    },
    {
      "page": "02 - APIs and model roles",
      "text": "Search snippets are leads.\nExtracted, validated passages\nare used as evidence.",
      "lines": 3,
      "height": 81
    },
    {
      "page": "02 - APIs and model roles",
      "text": "STEP 06",
      "lines": 1,
      "height": 18
    },
    {
      "page": "02 - APIs and model roles",
      "text": "Cloud Firestore",
      "lines": 1,
      "height": 29
    },
    {
      "page": "02 - APIs and model roles",
      "text": "Save user-owned results and sources.\nCommit the completed result and\nallowance update together.",
      "lines": 3,
      "height": 81
    },
    {
      "page": "02 - APIs and model roles",
      "text": "Firestore Python client\nBackend transaction + history APIs",
      "lines": 2,
      "height": 58
    },
    {
      "page": "02 - APIs and model roles",
      "text": "Private result history.\nReplaying the same request\ndoes not charge twice.",
      "lines": 3,
      "height": 81
    },
    {
      "page": "02 - APIs and model roles",
      "text": "VOTING \u2260 TRUTH VERDICT",
      "lines": 1,
      "height": 23
    },
    {
      "page": "02 - APIs and model roles",
      "text": "Voting chooses the claim category. The final assessment compares evidence and combines its stances.",
      "lines": 1,
      "height": 27
    }
  ]
}