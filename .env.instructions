# Sign in to https://ollama.com/ using Google
# Go to settings > keys > click "Add API Key" to generate API key
# Copy this template to uiabo/.env (the project root), then set your key there.
# The backend loads that exact file regardless of its working directory.
# Shell/deployment OLLAMA_API_KEY takes precedence. Restart after changing keys.
# .env is ignored by Git. Never put the key in mobile/ or EXPO_PUBLIC_* variables.
# Direct Ollama Cloud access is used; no local Ollama install or model download.

OLLAMA_API_KEY="_your_API_key_here"

# Enable the Fact Check Tools API in the Google Cloud project for this key.
GOOGLE_FACT_CHECK_API_KEY="_your_Google_Fact_Check_key_here"

# Use the Tavily key itself, not the complete MCP URL. Direct REST API calls.
TAVILY_API_KEY="_your_Tavily_key_here"

# Keep the Firebase Admin JSON outside the repository. Use your local absolute path.
GOOGLE_APPLICATION_CREDENTIALS="C:/path/outside/repository/service-account.json"
