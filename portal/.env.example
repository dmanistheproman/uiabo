# Firebase Console > Project settings > Your apps > Web app
# Same web-app values the mobile app uses (mobile/.env).
VITE_FIREBASE_API_KEY=replace_me
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace_me
VITE_FIREBASE_APP_ID=replace_me

# Leave empty to use the Vite proxy (backend on http://127.0.0.1:8000).
VITE_API_URL=

# Backend address the Vite dev server proxies to.
VITE_PROXY_TARGET=http://127.0.0.1:8000
